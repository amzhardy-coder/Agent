# Public URL of this deployment, no trailing slash
APP_URL=https://your-app.vercel.app

# Long random string. Protects the MCP endpoint and the accounts page.
# Generate with: openssl rand -hex 32
APP_SECRET=

# 32-byte key (64 hex chars) used to encrypt Gmail refresh tokens at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase project (Settings -> API). Service role key stays server-side only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
